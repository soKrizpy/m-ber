# M-Ber (Dompet Pintar Cimahi) Environment Configuration
# Copy this file to .env for local development, or set these in your Vercel Project Settings > Environment Variables

# ==========================================
# Google Gemini API Key (Server-side Advisor)
# ==========================================
# Optional: Enables Kang Tambal AI assistant, Smart Shopping List & Daily Tips.
# If omitted, M-Ber runs seamlessly using built-in local smart algorithms.
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# Firebase Web Client Configuration
# ==========================================
# Required for Google Sheets Cloud Backup & Google Account Sign-In.
# If using the default config, firebase-applet-config.json is used automatically.
# Set these in Vercel if overriding default values:
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=gen-lang-client-0025417287.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=gen-lang-client-0025417287
VITE_FIREBASE_STORAGE_BUCKET=gen-lang-client-0025417287.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=25209229277
VITE_FIREBASE_APP_ID=1:25209229277:web:67a455b717cce58282f034
